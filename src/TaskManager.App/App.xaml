<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TaskManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:TaskManager.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Monospaced (fixed-advance) figures so the CPU% / Memory columns line up
                vertically down the list (spec §6 "tabular figures"). WinUI 3 exposes no
                OpenType feature selector on TextBlock, so we select a monospaced family;
                Consolas ships on every supported Windows (10/11 22H2+, per the README).
            -->
            <FontFamily x:Key="TabularNumericFontFamily">Consolas</FontFamily>

            <!-- Shared converters and the usage-heat / status-pill brushes (theme-aware). -->
            <conv:UsageHeatToBrushConverter
                x:Key="HeatBrush"
                LowBrush="{ThemeResource TextFillColorSecondaryBrush}"
                MediumBrush="{ThemeResource TextFillColorPrimaryBrush}"
                HighBrush="{ThemeResource SystemFillColorCriticalBrush}" />

            <conv:BoolToBrushConverter
                x:Key="PillBackground"
                TrueBrush="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                FalseBrush="{ThemeResource ControlFillColorSecondaryBrush}" />

            <conv:BoolToBrushConverter
                x:Key="PillForeground"
                TrueBrush="{ThemeResource SystemFillColorSuccessBrush}"
                FalseBrush="{ThemeResource TextFillColorSecondaryBrush}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
