<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TaskManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:TaskManager.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters and the usage-heat / status-pill brushes (theme-aware). -->
            <conv:UsageHeatToBrushConverter
                x:Key="HeatBrush"
                LowBrush="{ThemeResource TextFillColorSecondaryBrush}"
                MediumBrush="{ThemeResource TextFillColorPrimaryBrush}"
                HighBrush="{ThemeResource SystemFillColorCriticalBrush}" />

            <conv:BoolToBrushConverter
                x:Key="PillBackground"
                TrueBrush="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                FalseBrush="{ThemeResource ControlFillColorSecondaryBrush}" />

            <conv:BoolToBrushConverter
                x:Key="PillForeground"
                TrueBrush="{ThemeResource SystemFillColorSuccessBrush}"
                FalseBrush="{ThemeResource TextFillColorSecondaryBrush}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
