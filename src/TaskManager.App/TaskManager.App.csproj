<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TaskManager.App: the WinUI 3 / Windows App SDK head (ADR-0001).

    Unpackaged desktop app (WindowsPackageType=None) because v1 distribution
    "barely matters — running a local build is enough" (spec §1). Targets the
    22H2 SDK because PROCESS_MEMORY_COUNTERS_EX2.PrivateWorkingSetSize — the
    Memory column source (spec §4) — needs Win10/11 22H2+.

    NOTE: Windows-only — this cannot be compiled on Linux/CI. It does NOT need a
    Visual Studio or Windows App SDK workload, though: the XAML compiler and SDK
    tooling arrive via the PackageReferences below. Build it as x64/arm64 (the .sln
    maps that) — AnyCPU breaks CsWin32's GetWindowLongPtr and then the XAML pass.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TaskManager.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The one authoritative version and copyright. The About dialog (issue #18) reads
         both from the running assembly's metadata at runtime, so neither can drift from the
         build; the copyright holder here matches the repo's LICENSE. -->
    <Version>1.0.0</Version>
    <Copyright>© 2026 REDHEADIT</Copyright>
    <!-- Carry the Windows App SDK runtime in the output folder so an unpackaged local
         build runs without a matching WindowsAppRuntime install (spec §1). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Hand-authored XAML only; Hot Reload, no visual designer (ADR-0001). -->
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc6" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskManager.Core\TaskManager.Core.csproj" />
  </ItemGroup>

</Project>
