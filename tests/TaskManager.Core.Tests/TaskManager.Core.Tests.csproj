<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the platform-neutral logic in TaskManager.Core. Runs on any
    host (net8.0) — no Win32/WinUI needed, which is the whole point of keeping
    the classifier, CPU math, ring buffer, and formatting in Core.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TaskManager.Core\TaskManager.Core.csproj" />
  </ItemGroup>

</Project>
