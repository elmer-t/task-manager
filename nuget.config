<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-level NuGet config. The user/machine-level config may enable
    packageSourceMapping for unrelated local feeds, which would block every
    package in this repo from resolving. Pin this repo to nuget.org only.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
